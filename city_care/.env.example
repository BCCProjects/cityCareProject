DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000, http://localhost:8081

# Database Settings
DB_ENGINE=mysql
MYSQL_DATABASE=city_care
MYSQL_USER=dev
MYSQL_PASSWORD=changeme
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQLDUMP_EXTRA_ARGS=--skip-ssl-verify-server-cert


# # Database Settings (MYSQL LOCAL)
# # SQLITE_NAME=db.sqlite3 #USE FOR TEST
# DB_ENGINE=mysql
# MYSQL_DATABASE=city_care
# MYSQL_USER=root
# MYSQL_PASSWORD=changeme
# MYSQL_HOST=host.docker.internal
# MYSQL_PORT=3306
# MYSQLDUMP_EXTRA_ARGS=--skip-ssl-verify-server-cert

# Auth Settings
X_USER=mycitycareuser
X_APP=mycitycareapp
X_SIGNATURE=secret-signature

# JWT Settings
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14
TIME_ZONE=America/Sao_Paulo

# Channels Settings
CHANNEL_LAYER_BACKEND=redis
CHANNEL_LAYER_REDIS_URL=redis://redis:6379/0

# Supabase Storage
SUPABASE_PROJECT_URL=https://rckdamcbitmzrjefrghs.supabase.co
SUPABASE_S3_ENDPOINT_URL=https://rckdamcbitmzrjefrghs.storage.supabase.co/storage/v1/s3
SUPABASE_ACCESS_KEY_ID=changeme
SUPABASE_SECRET_ACCESS_KEY=changeme
SUPABASE_S3_SIGNATURE_VERSION=s3v4
SUPABASE_S3_ADDRESSING_STYLE=path
SUPABASE_S3_REGION=us-east-2
SUPABASE_STORAGE_ENABLED=1

# Media
SUPABASE_ATTACHMENT_BUCKET_NAME=attachmentBucket
SUPABASE_ATTACHMENT_PREFIX=reportImages

# Backup
SUPABASE_BACKUP_BUCKET_NAME=backupBucket
SUPABASE_BACKUP_COMPLETE_PREFIX=completeBackup
SUPABASE_BACKUP_DIFFERENTIAL_PREFIX=differentialBackup

# Reverse geocoding (Nominatim/OpenStreetMap)
GEOCODING_NOMINATIM_URL=https://nominatim.openstreetmap.org/reverse
GEOCODING_USER_AGENT=CityCareMVP/1.0 (+https://example.com/contact)
GEOCODING_TIMEOUT_SECONDS=5
GEOCODING_CACHE_SECONDS=86400
GEOCODING_NOMINATIM_ZOOM=13
GEOCODING_ACCEPT_LANGUAGE=pt-BR,en
