DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
# DB_ENGINE=sqlite
# SQLITE_NAME=db.sqlite3
DB_ENGINE=mysql
MYSQL_DATABASE=city_care
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_HOST=localhost
MYSQL_PORT=3306
# MYSQLDUMP_PATH=/usr/bin/mysqldump                    # (Opcional) caminho manual do binário
# MYSQL_SSL_MODE=DISABLED                              # (Opcional) valor para --ssl-mode / --skip-ssl*
# MYSQLDUMP_EXTRA_ARGS=--skip-ssl-verify-server-cert   # (Opcional) flags extras passadas ao mysqldump
X_USER=mycitycareuser
X_APP=mycitycareapp
X_SIGNATURE=secret-signature
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14
TIME_ZONE=America/Sao_Paulo
CHANNEL_LAYER_BACKEND=memory
# CHANNEL_LAYER_REDIS_URL=redis://localhost:6379/0

# Supabase Storage (S3-compatible)
SUPABASE_PROJECT_URL=https://<your-project-ref>.supabase.co
SUPABASE_S3_ENDPOINT_URL=https://<your-project-ref>.storage.supabase.co/storage/v1/s3
SUPABASE_ACCESS_KEY_ID=
SUPABASE_SECRET_ACCESS_KEY=
SUPABASE_S3_SIGNATURE_VERSION=s3v4
SUPABASE_S3_ADDRESSING_STYLE=path
SUPABASE_S3_REGION=us-east-1
SUPABASE_STORAGE_ENABLED=1

# Media
SUPABASE_ATTACHMENT_BUCKET_NAME=attachmentBucket
SUPABASE_ATTACHMENT_PREFIX=reportImages

# Backup
SUPABASE_BACKUP_BUCKET_NAME=backupBucket
SUPABASE_BACKUP_COMPLETE_PREFIX=completeBackup
SUPABASE_BACKUP_DIFFERENTIAL_PREFIX=differentialBackup

# Reverse geocoding (Nominatim/OpenStreetMap)
GEOCODING_NOMINATIM_URL=https://nominatim.openstreetmap.org/reverse
GEOCODING_USER_AGENT=CityCareMVP/1.0 (+https://example.com/contact)
GEOCODING_TIMEOUT_SECONDS=5
GEOCODING_CACHE_SECONDS=86400
GEOCODING_NOMINATIM_ZOOM=13
GEOCODING_ACCEPT_LANGUAGE=pt-BR,en
